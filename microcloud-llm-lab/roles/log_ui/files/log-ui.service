[Unit]
Description=Log Analysis Dashboard
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/log-ui
Environment=LOG_DB_URL=http://log-db:5000
Environment=LOG_DB_TOKEN={{ vault_log_db_token }}
ExecStart=/usr/bin/python3 /opt/log-ui/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target